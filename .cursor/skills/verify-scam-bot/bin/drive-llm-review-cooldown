#!/usr/bin/env node
'use strict';

/**
 * Drive llm-review-cooldown (offline node:test). Writes evidence/<stamp>-llm-review-cooldown/.
 */

const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const skillDir = path.resolve(__dirname, '..');
const root = path.resolve(skillDir, '../../..');
const evidenceRoot = path.join(skillDir, 'evidence');

const TEST_NAMES = [
  'does not archive again after the user un-archives a chat the bot archived',
  'remembers the un-archive after a restart',
  'still blocks a curated malicious host in a restored chat',
  'reads LLM_REVIEW_COOLDOWN_MS with production default when unset',
  'tracks per-chat windows',
  'persists across store reload (process restart) until expiry',
  'prunes expired chat entries on load',
  'loads active cooldowns even when pruning the cooldown file cannot be saved',
  'skips LLM and mask for a second message in the same chat within the window',
  'does not cooldown-block after a benign review in primary or context mode',
  'starts cooldown after an archive in primary or context mode',
  'retries review after an automatic archive fails',
  'preserves an automatic archive when the cooldown file cannot be written',
  'keeps the guided cooldown while archive is deferred',
  'delivers a guided review and honors its archive vote when cooldown saving fails',
  'calls LLM again after the cooldown window expires',
  'does not cooldown-block a different chat',
  'still archives on heuristic hard-hit inside the cooldown window',
  'forwards SSE chat_archived un-archive events into userRestoredChats so false-positive AI verdicts only alert',
];

const TEST_FILES = ['lib/llm-review-cooldown.test.js', 'lib/wa-handlers.test.js', 'lib/wa-transport/whatsmeow.test.js'];

const UNSET_ENV = [
  'BLOCK_ENABLED',
  'HEURISTIC_ENABLED',
  'OPERATOR_MODE',
  'CONTEXT_LLM_ENABLED',
  'LLM_REVIEW_ENABLED',
  'MALICIOUS_HOSTS_PATH',
  'LLM_REVIEW_COOLDOWN_PATH',
];

function die(message) {
  console.error(`drive-llm-review-cooldown: ${message}`);
  process.exit(1);
}

function stamp() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, '0');
  return (
    `${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}` +
    `T${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}Z`
  );
}

const outDir = path.join(evidenceRoot, `${stamp()}-llm-review-cooldown`);
fs.mkdirSync(outDir, { recursive: true });

const pattern = TEST_NAMES.map((name) => name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
const env = { ...process.env, LLM_REVIEW_COOLDOWN_MS: '0' };
for (const key of UNSET_ENV) delete env[key];

const test = spawnSync(
  'node',
  ['--test', '--test-reporter', 'tap', `--test-name-pattern=${pattern}`, ...TEST_FILES],
  { cwd: root, env, encoding: 'utf8' },
);
const tap = `${test.stdout || ''}${test.stderr || ''}`;
fs.writeFileSync(path.join(outDir, 'node-test.txt'), tap);

const missing = TEST_NAMES.filter((name) => {
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return !new RegExp(`^\\s*ok \\d+ - ${escaped}$`, 'm').test(tap);
});
const failLine = tap.split('\n').find((line) => line.startsWith('# fail ')) || '# fail missing';
const passLine = tap.split('\n').find((line) => line.startsWith('# pass ')) || '# pass missing';
const testsOk = test.status === 0 && failLine === '# fail 0' && missing.length === 0;

const summary = {
  feature: 'llm-review-cooldown',
  entry: `node --test ${TEST_FILES.join(' ')}`,
  surface: 'cooldown store, inbound processing, and fake WhatsApp client handlers (offline)',
  whatsapp: 'not started',
  nodeTestExit: test.status,
  passLine,
  failLine,
  missingTests: missing,
  proved: testsOk,
};
fs.writeFileSync(path.join(outDir, 'summary.json'), `${JSON.stringify(summary, null, 2)}\n`);
console.log(`evidence: ${outDir}`);
console.log(JSON.stringify(summary, null, 2));
if (!summary.proved) die('llm-review-cooldown tests did not all pass');
