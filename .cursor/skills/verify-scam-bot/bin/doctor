#!/usr/bin/env bash
# Read-only check: is the verification stub this run started worth driving?
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_DIR="$(cd "$BIN_DIR/.." && pwd)"
ROOT="$(cd "$SKILL_DIR/../../.." && pwd)"
RUN_DIR="$SKILL_DIR/run"

fail() {
  echo "worth_driving: no"
  echo "reason: $1"
  exit 1
}

if [[ ! -f "$ROOT/package.json" || ! -f "$ROOT/stub-jevlike.js" ]]; then
  fail "repo root not found from $SKILL_DIR"
fi

node_ver="$(node -v 2>/dev/null || true)"
py_ver="$(python3 --version 2>/dev/null || true)"
echo "node: ${node_ver:-missing}"
echo "python3: ${py_ver:-missing}"
if [[ -d "$ROOT/node_modules/whatsapp-web.js" ]]; then
  echo "node_modules: present"
else
  echo "node_modules: absent"
fi
if [[ -f "$ROOT/models/jevlike_hf_chinese_roberta_r1.pt" ]]; then
  echo "checkpoint: present"
else
  echo "checkpoint: absent"
fi
if [[ -f "$ROOT/models/jevlike_hf_pii_mask.pt" ]]; then
  echo "pii_mask: present"
else
  echo "pii_mask: absent"
fi

[[ "$node_ver" == v* ]] || fail "node is not on PATH (need Node >= 20)"

pidfile="$RUN_DIR/stub.pid"
[[ -f "$pidfile" ]] || fail "no verification stub is running; run bin/launch-stub"
pid="$(cat "$pidfile")"
[[ "$pid" =~ ^[0-9]+$ ]] || fail "stub.pid is not a pid"
kill -0 "$pid" 2>/dev/null || fail "stub pid $pid is not running"
STUB_RUN_DIR="$RUN_DIR" node "$BIN_DIR/_stub-pid-looks-like.js" "$pid" stub-jevlike.js "$RUN_DIR" \
  || fail "pid $pid is not stub-jevlike.js; refusing to treat it as ours"

base="$(cat "$RUN_DIR/base-url" 2>/dev/null || true)"
port="$(cat "$RUN_DIR/port" 2>/dev/null || true)"
[[ -n "$base" && -n "$port" ]] || fail "run/base-url or run/port is missing"
echo "instance: stub-jevlike"
echo "pid: $pid"
echo "port: $port"
echo "base_url: $base"

health="$(curl -fsS --max-time 2 "$base/health" 2>/dev/null || true)"
[[ -n "$health" ]] || fail "GET $base/health failed"
echo "health: $health"
node -e '
  const health = JSON.parse(process.argv[1]);
  if (health.ok !== true || health.model !== "stub-jevlike") {
    console.error("health is not the stub worker");
    process.exit(1);
  }
' "$health" || fail "health JSON is not {ok:true, model:stub-jevlike}"

echo "worth_driving: yes"
