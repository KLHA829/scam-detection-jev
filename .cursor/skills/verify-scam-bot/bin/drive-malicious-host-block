#!/usr/bin/env node
'use strict';

/**
 * Drive the malicious-host-block feature (offline node:test only).
 * Writes proof under .cursor/skills/verify-scam-bot/evidence/<stamp>-malicious-host-block/.
 */

const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const skillDir = path.resolve(__dirname, '..');
const root = path.resolve(skillDir, '../../..');
const evidenceRoot = path.join(skillDir, 'evidence');

const TEST_NAMES = [
  'matches IDN URLs spelled as xn--fsqu00a.com against either list spelling',
  'matches IDN URLs spelled as 例子.com against either list spelling',
  'preserves path and IPv6 list entries without widening host rules',
  'ignores non-string entries in explicitly supplied host lists',
  'matches exact host and subdomains from the data file',
  'keeps the previous list when reload hits a non-string host entry',
  'startMaliciousHostsWatcher reloads after the file changes',
  'startMaliciousHostsWatcher reloads repeated atomic saves and a subsequent in-place write',
  'startMaliciousHostsWatcher reloads atomic saves through a symlink in another directory',
  'archives via link rules and blocks only unsaved contacts through block policy',
  'blocks an unsaved contact on a listed host without waiting for the scorer',
  'distinguishes blocklisted email addresses from links in the inbound handler',
  'blocks a malicious host without waiting for the scorer',
  'holds auto-block while the setup choice is unanswered (malicious host only)',
];

const TEST_FILES = ['lib/malicious-hosts.test.js', 'lib/block-policy.test.js'];

const UNSET_ENV = [
  'ARCHIVE_THRESHOLD',
  'SAFE_THRESHOLD',
  'BLOCK_THRESHOLD',
  'BLOCK_ENABLED',
  'HEURISTIC_ENABLED',
  'OPERATOR_MODE',
  'CONTEXT_LLM_ENABLED',
  'LLM_REVIEW_ENABLED',
  'SCORER',
  'MALICIOUS_HOSTS_PATH',
];

function die(message) {
  console.error(`drive-malicious-host-block: ${message}`);
  process.exit(1);
}

function stamp() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, '0');
  return (
    `${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}` +
    `T${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}Z`
  );
}

const outDir = path.join(evidenceRoot, `${stamp()}-malicious-host-block`);
fs.mkdirSync(outDir, { recursive: true });

const pattern = TEST_NAMES.map((name) => name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
const env = { ...process.env };
for (const key of UNSET_ENV) delete env[key];

const test = spawnSync(
  'node',
  ['--test', '--test-reporter', 'tap', `--test-name-pattern=${pattern}`, ...TEST_FILES],
  { cwd: root, env, encoding: 'utf8' },
);
const tap = `${test.stdout || ''}${test.stderr || ''}`;
fs.writeFileSync(path.join(outDir, 'node-test.txt'), tap);

const missing = TEST_NAMES.filter((name) => {
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return !new RegExp(`^\\s*ok \\d+ - ${escaped}$`, 'm').test(tap);
});
const failLine = tap.split('\n').find((line) => line.startsWith('# fail ')) || '# fail missing';
const passLine = tap.split('\n').find((line) => line.startsWith('# pass ')) || '# pass missing';
const testsOk = test.status === 0 && failLine === '# fail 0' && missing.length === 0;

const summary = {
  feature: 'malicious-host-block',
  entry: 'node --test lib/malicious-hosts.test.js lib/block-policy.test.js',
  scorer: 'in-process stub client (no HTTP worker)',
  whatsapp: 'not started',
  nodeTestExit: test.status,
  passLine,
  failLine,
  missingTests: missing,
  proved: testsOk,
};
fs.writeFileSync(path.join(outDir, 'summary.json'), `${JSON.stringify(summary, null, 2)}\n`);
console.log(`evidence: ${outDir}`);
console.log(JSON.stringify(summary, null, 2));
if (!summary.proved) die('malicious-host tests did not all pass');
