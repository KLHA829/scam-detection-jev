#!/usr/bin/env node
'use strict';

/**
 * Drive the agents-md-invariants feature (offline node:test only).
 * Writes proof under .cursor/skills/verify-scam-bot/evidence/<stamp>-agents-md-invariants/.
 * Does not open WhatsApp, Chrome, or the HTTP stub worker.
 */

const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const skillDir = path.resolve(__dirname, '..');
const root = path.resolve(skillDir, '../../..');
const evidenceRoot = path.join(skillDir, 'evidence');

const TEST_NAMES = [
  'guided block preserves live names: saved named contact',
  'guided block preserves live names: saved unnamed contact',
  'guided block preserves live names: named contact without saved flag',
  'guided block preserves live names: unsaved unnamed contact',
  'guided block does not rename when live contact lookup fails',
  'guided reblocks from two pending polls retain temporary contact cleanup',
  'invariant: saved contacts are never auto-blocked (blockEligibility stays null)',
  'invariant: unsaved jevlike score at or above BLOCK_THRESHOLD alone does not block',
  'invariant: unsaved lookalike link rule does not auto-block (archive only)',
  'invariant: unsaved short_link_solicit does not auto-block',
  'invariant: unsaved malicious_host on the current message may block',
  'invariant: applyBlockPolicy archives saved contacts even with link heuristic on current message',
  'invariant: applyBlockPolicy archives unsaved block-line score without link rule or context block',
  'invariant: scorer unknown (ok:false) never promotes to block via applyBlockPolicy',
  'invariant: non-heuristic messages ignore before LLM merge',
  'invariant: link heuristic archives without a score',
  'invariant: mask failure alone never archives in the live decision path',
  'invariant: LLM scam archives unsaved contact and never calls blockContact',
  'invariant: saved contact LLM archive does not call blockContact',
  'invariant: context-model block archives only and never auto-blocks',
  'invariant: unsaved lookalike archives without waiting on score and does not block',
];

const TEST_FILES = ['lib/agents-invariants.test.js', 'lib/guided-block-name.test.js'];

const UNSET_ENV = [
  'ARCHIVE_THRESHOLD',
  'SAFE_THRESHOLD',
  'BLOCK_THRESHOLD',
  'BLOCK_ENABLED',
  'HEURISTIC_ENABLED',
  'OPERATOR_MODE',
  'CONTEXT_LLM_ENABLED',
  'LLM_REVIEW_ENABLED',
  'SCORER',
  'MALICIOUS_HOSTS_PATH',
];

function die(message) {
  console.error(`drive-agents-invariants: ${message}`);
  process.exit(1);
}

function stamp() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, '0');
  return (
    `${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}` +
    `T${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}Z`
  );
}

const outDir = path.join(evidenceRoot, `${stamp()}-agents-md-invariants`);
fs.mkdirSync(outDir, { recursive: true });

const pattern = TEST_NAMES.map((name) => name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
const env = { ...process.env };
for (const key of UNSET_ENV) delete env[key];

const test = spawnSync(
  'node',
  ['--test', '--test-reporter', 'tap', `--test-name-pattern=${pattern}`, ...TEST_FILES],
  { cwd: root, env, encoding: 'utf8' },
);
const tap = `${test.stdout || ''}${test.stderr || ''}`;
fs.writeFileSync(path.join(outDir, 'node-test.txt'), tap);

const missing = TEST_NAMES.filter((name) => {
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return !new RegExp(`^\\s*ok \\d+ - ${escaped}$`, 'm').test(tap);
});
const failLine = tap.split('\n').find((line) => line.startsWith('# fail ')) || '# fail missing';
const passLine = tap.split('\n').find((line) => line.startsWith('# pass ')) || '# pass missing';
const testsOk = test.status === 0 && failLine === '# fail 0' && missing.length === 0;

const summary = {
  feature: 'agents-md-invariants',
  entry: 'node --test lib/agents-invariants.test.js',
  scorer: 'in-process stub client (no HTTP worker)',
  whatsapp: 'not started',
  nodeTestExit: test.status,
  passLine,
  failLine,
  missingTests: missing,
  proved: testsOk,
};
fs.writeFileSync(path.join(outDir, 'summary.json'), `${JSON.stringify(summary, null, 2)}\n`);
console.log(`evidence: ${outDir}`);
console.log(JSON.stringify(summary, null, 2));
if (!summary.proved) die('invariant tests did not all pass');
