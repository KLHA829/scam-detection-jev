#!/usr/bin/env node
'use strict';

/**
 * Drive the score-archive feature against the stub this run launched.
 * Writes proof under .cursor/skills/verify-scam-bot/evidence/<stamp>-score-archive/.
 * Does not open WhatsApp or Chrome. Does not delete older evidence.
 */

const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const skillDir = path.resolve(__dirname, '..');
const root = path.resolve(skillDir, '../../..');
const runDir = path.join(skillDir, 'run');
const evidenceRoot = path.join(skillDir, 'evidence');

const TEST_NAMES = [
  'archives on score >= T for any sender',
  'labels using archive / safe thresholds',
  'returns stub scam as scam',
  'returns stub benign as not_scam',
  'archives a high score and does not block on the score alone',
  'archives an unsaved high score without blocking',
  'does not archive a failed score that still carries a high number',
  'ignores unknown for unsaved non-local and local unsaved',
  'does not archive unsaved non-local numbers from score-or-heuristic alone',
  'ignores low score for local unsaved and for saved foreign',
  'createScoreClient always builds a JevlikeClient (SCORER env is ignored)',
  'archives jevlike_score for a high stub score',
  'archives via callback on high stub score',
  'fails closed on timeout / 5xx / invalid JSON',
  'fails closed on jevlike timeout without archiving',
  'fails closed on jevlike HTTP 5xx without archiving',
];

const TEST_FILES = [
  'whatsapp-bot.test.js',
  'lib/block-policy.test.js',
  'lib/scorer.test.js',
];

const UNSET_ENV = [
  'ARCHIVE_THRESHOLD',
  'SAFE_THRESHOLD',
  'BLOCK_THRESHOLD',
  'BLOCK_ENABLED',
  'HEURISTIC_ENABLED',
  'OPERATOR_MODE',
  'CONTEXT_LLM_ENABLED',
  'LLM_REVIEW_ENABLED',
  'SCORER',
];

function die(message) {
  console.error(`drive-score-archive: ${message}`);
  process.exit(1);
}

function readText(file) {
  return fs.readFileSync(file, 'utf8').trim();
}

function stamp() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, '0');
  return (
    `${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}` +
    `T${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}Z`
  );
}

function postJson(base, pathname, body) {
  const url = `${base}${pathname}`;
  const result = spawnSync(
    'curl',
    [
      '-fsS',
      '--max-time',
      '5',
      '-X',
      'POST',
      '-H',
      'content-type: application/json',
      '--data-binary',
      '@-',
      url,
    ],
    { input: JSON.stringify(body), encoding: 'utf8' },
  );
  if (result.status !== 0) {
    die(`POST ${url} failed: ${result.stderr || result.stdout || result.error}`);
  }
  return result.stdout;
}

const doctor = spawnSync(path.join(__dirname, 'doctor'), { encoding: 'utf8' });
process.stdout.write(doctor.stdout || '');
process.stderr.write(doctor.stderr || '');
if (doctor.status !== 0) die('doctor failed; not driving');

const base = readText(path.join(runDir, 'base-url'));
const outDir = path.join(evidenceRoot, `${stamp()}-score-archive`);
fs.mkdirSync(outDir, { recursive: true });
fs.writeFileSync(path.join(outDir, 'doctor.txt'), doctor.stdout);

const health = spawnSync('curl', ['-fsS', '--max-time', '5', `${base}/health`], {
  encoding: 'utf8',
});
if (health.status !== 0) die(`GET ${base}/health failed`);
fs.writeFileSync(path.join(outDir, 'health.json'), `${health.stdout.trim()}\n`);

const scamBody = { text: '[stub:scam] 請立即轉帳' };
const benignBody = { text: '今晚飲茶？' };
fs.writeFileSync(path.join(outDir, 'score-scam.request.json'), `${JSON.stringify(scamBody)}\n`);
fs.writeFileSync(
  path.join(outDir, 'score-benign.request.json'),
  `${JSON.stringify(benignBody)}\n`,
);
const scamRaw = postJson(base, '/v1/score', scamBody);
const benignRaw = postJson(base, '/v1/score', benignBody);
fs.writeFileSync(path.join(outDir, 'score-scam.json'), `${scamRaw.trim()}\n`);
fs.writeFileSync(path.join(outDir, 'score-benign.json'), `${benignRaw.trim()}\n`);

const scam = JSON.parse(scamRaw);
const benign = JSON.parse(benignRaw);
const httpErrors = [];
if (scam.model !== 'stub-jevlike' || scam.label !== 'scam' || !(scam.score >= 42)) {
  httpErrors.push(`scam response was ${JSON.stringify(scam)}`);
}
if (benign.model !== 'stub-jevlike' || benign.label !== 'not_scam' || !(benign.score <= 18)) {
  httpErrors.push(`benign response was ${JSON.stringify(benign)}`);
}

const launchLog = path.join(runDir, 'stub.log');
if (fs.existsSync(launchLog)) {
  fs.copyFileSync(launchLog, path.join(outDir, 'launch.log'));
}

const pattern = TEST_NAMES.map((name) => name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
const env = { ...process.env };
for (const key of UNSET_ENV) delete env[key];
const test = spawnSync(
  'node',
  ['--test', '--test-reporter', 'tap', `--test-name-pattern=${pattern}`, ...TEST_FILES],
  { cwd: root, env, encoding: 'utf8' },
);
const tap = `${test.stdout || ''}${test.stderr || ''}`;
fs.writeFileSync(path.join(outDir, 'node-test.txt'), tap);

const missing = TEST_NAMES.filter((name) => {
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return !new RegExp(`^\\s*ok \\d+ - ${escaped}$`, 'm').test(tap);
});
const failLine = tap.split('\n').find((line) => line.startsWith('# fail ')) || '# fail missing';
const passLine = tap.split('\n').find((line) => line.startsWith('# pass ')) || '# pass missing';
const testsOk = test.status === 0 && failLine === '# fail 0' && missing.length === 0;

const summary = {
  feature: 'score-archive',
  entry: 'stub POST /v1/score plus node --test subset',
  baseUrl: base,
  scorer: 'stub-jevlike',
  weights: 'not used',
  whatsapp: 'not started',
  scam: { label: scam.label, score: scam.score, model: scam.model },
  benign: { label: benign.label, score: benign.score, model: benign.model },
  nodeTestExit: test.status,
  passLine,
  failLine,
  missingTests: missing,
  httpErrors,
  proved: testsOk && httpErrors.length === 0,
};
fs.writeFileSync(path.join(outDir, 'summary.json'), `${JSON.stringify(summary, null, 2)}\n`);
console.log(`evidence: ${outDir}`);
console.log(JSON.stringify(summary, null, 2));
if (!summary.proved) process.exit(1);
