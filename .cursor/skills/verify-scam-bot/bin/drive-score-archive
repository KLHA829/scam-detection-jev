#!/usr/bin/env node
'use strict';

/**
 * Deprecated alias (2026-10-16): live path is mask → LLM, not score archive.
 * Delegates to drive-llm-primary.
 */

console.error('drive-score-archive: deprecated; running drive-llm-primary instead');
const { spawnSync } = require('child_process');
const path = require('path');
const r = spawnSync(path.join(__dirname, 'drive-llm-primary'), {
  stdio: 'inherit',
  env: process.env,
});
process.exit(typeof r.status === 'number' ? r.status : 1);
