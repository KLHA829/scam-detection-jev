#!/usr/bin/env node
'use strict';

/**
 * Primary smoke drive: stub POST /v1/mask plus mask→LLM node:test subset.
 * Writes proof under .cursor/skills/verify-scam-bot/evidence/<stamp>-mask-before-llm/.
 */

const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');
const { spawnSkillScript } = require('./_spawn-skill-script');

const skillDir = path.resolve(__dirname, '..');
const root = path.resolve(skillDir, '../../..');
const runDir = path.join(skillDir, 'run');
const evidenceRoot = path.join(skillDir, 'evidence');

const TEST_NAMES = [
  ...['default context', 'single-message'].flatMap((path) =>
    ['benign', 'scam', 'invalid', 'unavailable'].map(
      (verdict) => `invariant: keyword rules require AI confirmation (${path}, ${verdict})`,
    ),
  ),
  'routes curated malicious hosts (warnings and lures) through masked LLM review without leaking raw hostnames',
  'fails closed when curated malicious-host masking fails',
  'drops the original when an edit is empty',
  'does not resend the original after an empty edit with 0 earlier messages',
  'does not resend the original after an empty edit with 1 earlier messages',
  ...['not_scam', 'unknown', 'invalid', null].flatMap((label) => [
    `rejects should_archive for non-scam label ${label}`,
    `merge ignores contradictory non-scam label ${label}`,
    `does not archive contradictory non-scam reply ${label}`,
  ]),
  'sends short-link advice and authority mentions to masked AI review',
  'routes short links (including OTP, money, and impersonation text) directly to masked AI review',
  'fails closed when masking short-link advice fails',
  'sends official hsbc.co.uk links to masked AI review',
  'sends official hsbc.com.cn links to masked AI review',
  'sends official hsbc.com.au links to masked AI review',
  'sends official hsbc.com.sg links to masked AI review',
  'still flags HSBC regional lookalikes on unrelated hosts',
  'LLM_REVIEW_ALL does not override explicitly disabled review',
  'LLM_REVIEW_ALL keeps inbound review disabled with context default',
  'LLM_REVIEW_ALL keeps inbound review disabled with context 0',
  'full mask endpoint reaches review through the real inbound handler',
  'endpoint resolution normalizes mask base URLs',
  'disabled review skips the chat API and fails closed on every message including curated hosts',
  'treats money received, own-account alerts and do-not-share codes as no_action',
  'sends the masked recent messages and archives when the model says archive',
  'replaces phone, name, and otp with typed placeholders and keeps the lure word',
  'does not call the model when masking fails',
  'rejects a mask payload that would leave the text raw',
  'archives llm_review_scam when the model flags scam',
  'does not archive when mask fails for local unsaved',
  "sends the user's question and the reply as masked turns marked by speaker",
  'keeps the official PayMe domain readable and tells the model it is official',
  'leaves lookalike and other domains masked and only notes the device-detected lookalike',
  "names brands' own domains and leaves lookalikes and other domains out",
  'does not count a brand domain inside a login, an email, another link or a longer name',
];

const TEST_FILES = [
  'lib/agents-invariants.test.js',
  'lib/link-rules.test.js',
  'lib/llm-review.test.js',
  'lib/jevlike-base-url.test.js',
  'lib/llm-review-disabled.test.js',
  'lib/context-llm.test.js',
  'lib/audit-functions.test.js',
  'whatsapp-bot.test.js',
];

const UNSET_ENV = [
  'BLOCK_ENABLED',
  'HEURISTIC_ENABLED',
  'OPERATOR_MODE',
  'CONTEXT_LLM_ENABLED',
  'LLM_REVIEW_ENABLED',
];

function die(message) {
  console.error(`drive-mask-before-llm: ${message}`);
  process.exit(1);
}

function readText(file) {
  return fs.readFileSync(file, 'utf8').trim();
}

function stamp() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, '0');
  return (
    `${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}` +
    `T${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}Z`
  );
}

function postJson(base, pathname, body) {
  const url = `${base}${pathname}`;
  const result = spawnSync(
    'curl',
    [
      '-fsS',
      '--max-time',
      '5',
      '-X',
      'POST',
      '-H',
      'content-type: application/json',
      '--data-binary',
      '@-',
      url,
    ],
    { input: JSON.stringify(body), encoding: 'utf8' },
  );
  if (result.status !== 0) {
    die(`POST ${url} failed: ${result.stderr || result.stdout || result.error}`);
  }
  return result.stdout;
}

const doctor = spawnSkillScript('doctor');
process.stdout.write(doctor.stdout || '');
process.stderr.write(doctor.stderr || '');
if (doctor.status !== 0) die('doctor failed; not driving');

const base = readText(path.join(runDir, 'base-url'));
const outDir = path.join(evidenceRoot, `${stamp()}-mask-before-llm`);
fs.mkdirSync(outDir, { recursive: true });
fs.writeFileSync(path.join(outDir, 'doctor.txt'), doctor.stdout);

const health = spawnSync('curl', ['-fsS', '--max-time', '5', `${base}/health`], {
  encoding: 'utf8',
});
if (health.status !== 0) die(`GET ${base}/health failed`);
fs.writeFileSync(path.join(outDir, 'health.json'), `${health.stdout.trim()}\n`);

const maskBody = {
  messages: ['我係陳大文 電話 91234567 驗證碼過期請發俾我'],
};
const emptyBody = { messages: ['今晚飲茶？'] };
fs.writeFileSync(path.join(outDir, 'mask.request.json'), `${JSON.stringify(maskBody)}\n`);
const maskRaw = postJson(base, '/v1/mask', maskBody);
const emptyRaw = postJson(base, '/v1/mask', emptyBody);
fs.writeFileSync(path.join(outDir, 'mask.json'), `${maskRaw.trim()}\n`);
fs.writeFileSync(path.join(outDir, 'mask-empty.json'), `${emptyRaw.trim()}\n`);

const mask = JSON.parse(maskRaw);
const empty = JSON.parse(emptyRaw);
const httpErrors = [];
if (mask.ok !== true || mask.model !== 'stub-jevlike' || !Array.isArray(mask.messages?.[0]?.spans)) {
  httpErrors.push(`mask response was ${JSON.stringify(mask)}`);
}
if (empty.ok !== true || !Array.isArray(empty.messages?.[0]?.spans) || empty.messages[0].spans.length !== 0) {
  httpErrors.push(`empty mask response was ${JSON.stringify(empty)}`);
}

const launchLog = path.join(runDir, 'stub.log');
if (fs.existsSync(launchLog)) {
  fs.copyFileSync(launchLog, path.join(outDir, 'launch.txt'));
}

const pattern = TEST_NAMES.map((name) => name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
const env = { ...process.env };
for (const key of UNSET_ENV) delete env[key];
const test = spawnSync(
  'node',
  ['--test', '--test-reporter', 'tap', `--test-name-pattern=${pattern}`, ...TEST_FILES],
  { cwd: root, env, encoding: 'utf8' },
);
const tap = `${test.stdout || ''}${test.stderr || ''}`;
fs.writeFileSync(path.join(outDir, 'node-test.txt'), tap);

const missing = TEST_NAMES.filter((name) => {
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return !new RegExp(`^\\s*ok \\d+ - ${escaped}$`, 'm').test(tap);
});
const failLine = tap.split('\n').find((line) => line.startsWith('# fail ')) || '# fail missing';
const passLine = tap.split('\n').find((line) => line.startsWith('# pass ')) || '# pass missing';
const testsOk = test.status === 0 && failLine === '# fail 0' && missing.length === 0;

const summary = {
  feature: 'mask-before-llm',
  entry: 'stub POST /v1/mask plus node --test subset',
  baseUrl: base,
  worker: 'stub-jevlike',
  whatsapp: 'not started',
  maskSpans: mask.messages?.[0]?.spans?.length ?? null,
  nodeTestExit: test.status,
  passLine,
  failLine,
  missingTests: missing,
  httpErrors,
  proved: testsOk && httpErrors.length === 0,
};
fs.writeFileSync(path.join(outDir, 'summary.json'), `${JSON.stringify(summary, null, 2)}\n`);
console.log(`evidence: ${outDir}`);
console.log(JSON.stringify(summary, null, 2));
if (!summary.proved) process.exit(1);
