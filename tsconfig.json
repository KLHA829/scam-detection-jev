{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "whatsapp-bot.js",
    "lib/**/*.js",
    "lab/**/*.js",
    "scripts/**/*.js",
    "stub-jevlike.js"
  ],
  "exclude": [
    "**/*.test.js",
    "**/*.spec.js",
    "test/**",
    "node_modules",
    "graphify-out",
    "models",
    ".cursor/skills/**/evidence"
  ]
}
