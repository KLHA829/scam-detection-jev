# LightJev typed-decision endpoint (local worker by default).
# Start the worker first: python lightjev_serve.py
LIGHTJEV_BASE_URL=http://127.0.0.1:8765
LIGHTJEV_API_KEY=
LIGHTJEV_TIMEOUT_MS=30000

# Worker-only (python lightjev_serve.py)
LIGHTJEV_HOST=127.0.0.1
LIGHTJEV_PORT=8765
LIGHTJEV_CHECKPOINT=rongxinzy/LightJev-0.6B-v0.1
LIGHTJEV_DEVICE=cpu
LIGHTJEV_TEMPERATURE=1

# Rubric thresholds (0–100). Override scoring-rubric.json without code changes.
ARCHIVE_THRESHOLD=42
SAFE_THRESHOLD=18

# Optional: JSON file path (default: ./scoring-rubric.json)
# RUBRIC_PATH=./scoring-rubric.json

# Heuristic backup (archive-only). Set 0/false to disable.
HEURISTIC_ENABLED=true

# Startup: archive unsaved non-local numbers in the first 10 sidebar 1:1 chats (no scoring).
STARTUP_FOREIGN_SCAN=true

# Score cache TTL in ms (0 disables).
SCORE_CACHE_TTL_MS=900000

# WhatsApp Web / Puppeteer
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_DOWNLOAD=true
