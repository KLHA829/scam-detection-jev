# Local jevlike worker: PII mask (required for any LLM). Scam score head is optional (lab eval).
# Raspberry Pi / CPU: run python jevlike_serve.py with JEVLIKE_MASK_CKPT loaded.

# --- jevlike worker (python jevlike_serve.py) ---
# Worker base URL or full /v1/mask endpoint (trailing slashes are accepted).
JEVLIKE_BASE_URL=http://127.0.0.1:8766
JEVLIKE_API_KEY=
JEVLIKE_TIMEOUT_MS=30000
JEVLIKE_HOST=127.0.0.1
JEVLIKE_PORT=8766
# Maximum HTTP request body in bytes; larger requests return 413.
# JEVLIKE_MAX_BODY=65536
# Fallback aliases: unset by default; JEVLIKE_CKPT / JEVLIKE_ENCODER take precedence.
# JEVLIKE_CHECKPOINT=
# JEVLIKE_HF_MODEL=
# Optional scam scorer (offline eval / POST /v1/score only — not live inbound):
# JEVLIKE_CKPT=models/jevlike_hf_chinese_roberta_r1.pt
JEVLIKE_ENCODER=hfl/chinese-roberta-wwm-ext
JEVLIKE_DEVICE=cpu
JEVLIKE_OPTIONS=not_scam,scam

# Rubric thresholds — legacy jevlike lab eval (scoring-rubric.json). Not live archive lines.
ARCHIVE_THRESHOLD=42
SAFE_THRESHOLD=18

# Block unsaved contacts only when the current message URL matches
# data/malicious-hosts.json (optional MALICIOUS_HOSTS_PATH). Saved contacts are
# never auto-blocked. Lookalike and soliciting short-link rules go to AI
# review; they never archive or block on their own. Models and LLM never auto-block.
# BLOCK_ENABLED=false keeps archive-only (no malicious-host block either).
BLOCK_ENABLED=true
# MALICIOUS_HOSTS_PATH=./data/malicious-hosts.json
# MALICIOUS_HOSTS_ALLOW_EMPTY=1  # required to reload hosts:[] and clear the in-memory list
# BLOCK_LOG_PATH=./blocks.jsonl
# Contacts whose name the bot wrote (block or （可疑推銷） label); only those names are not treated as saved contacts.
# BOT_CONTACT_NAMES_PATH=./bot-contact-names.json
# Chats the user moved out of the archive; model verdicts there only alert the operator.
# USER_RESTORED_CHATS_PATH=./user-restored-chats.json

# First-run choice, asked in your own WhatsApp chat. Leave unset to ask once.
# Until you answer, the bot archives suspicious chats and does not auto-block
# (malicious-host block is also held until you pick automatic mode).
# auto = archive and graded block. guided = forward each suspicious DM to
# yourself, explain it after masking, and wait for your poll choice.
# OPERATOR_MODE=auto
# OPERATOR_MODE=guided
# OPERATOR_MODE_PATH=./operator-mode.json
# REVIEW_QUEUE_PATH=./review-queue.json

# Gap between rename, block, mute, and archive. Chats are changed one at a time.
WA_ACTION_GAP_MS=3000

# Recent inbound texts kept in memory for optional CONTEXT_LLM_ENABLED and receipts.
# Live path does not jevlike-score a thread window.
CONTEXT_TURNS=4

# Enable link rules and the curated blocklist fast path.
HEURISTIC_ENABLED=true

# --- Primary LLM judgment (required except on the curated blocklist fast path) ---
# Default ON. Set false only to debug (fail closed: no archive without a curated blocklist match).
LLM_REVIEW_ENABLED=true
# Backend: OpenAI-compatible POST {base}/chat/completions
# LLM_REVIEW_API_URL=https://api.openai.com/v1
# LLM_REVIEW_API_URL=http://127.0.0.1:11434/v1
# LLM_REVIEW_MODEL=gpt-4o-mini
# LLM_REVIEW_API_KEY=
# Fallbacks, all unset by default: API_URL > OPENAI_BASE_URL > OPENAI_API_BASE;
# API_KEY > OPENAI_API_KEY (the LLM_REVIEW_ prefix applies to API_URL / API_KEY).
# No URL is assumed when all URL settings are unset; no key means no auth header.
# OPENAI_BASE_URL=
# OPENAI_API_BASE=
# OPENAI_API_KEY=
# LLM_REVIEW_TIMEOUT_MS=8000
# LLM_REVIEW_ALL=0  # Legacy compatibility flag; no effect on review enablement or trigger selection.
# Minimum model confidence (0–1) before an LLM or context-LLM archive applies.
# LLM_REVIEW_MIN_CONFIDENCE=0.7
# Per-chat LLM cooldown (ms; default 600000 = 10 min).
# Starts after a successful automatic archive or on a guided archive recommendation.
# Survives restart if saved to llm-review-cooldown.json (optional LLM_REVIEW_COOLDOWN_PATH).
# LLM_REVIEW_COOLDOWN_MS=600000
# LLM_REVIEW_COOLDOWN_PATH=./llm-review-cooldown.json

# Context review: masked latest inbound messages → same chat API (archive/block/no_action).
# Default on when unset. Set CONTEXT_LLM_ENABLED=0 or false to use single-message LLM instead.
# CONTEXT_LLM_ENABLED=1
# CONTEXT_LLM_MESSAGES=10

# PII mask head — required before LLM_REVIEW or guided explanations.
# Download: scripts/download_pii_mask_ckpt.sh
# Train instead: python scripts/train_pii_mask.py --output models/jevlike_hf_pii_mask.pt
JEVLIKE_MASK_CKPT=models/jevlike_hf_pii_mask.pt

# --- Self-chat Cantonese voice commands (optional local ASR worker) ---
# Off by default. Voice notes work only in your own self-chat and are transcribed locally.
VOICE_COMMANDS_ENABLED=false
VOICE_ASR_BASE_URL=http://127.0.0.1:8768
# VOICE_ASR_API_KEY=
VOICE_ASR_TIMEOUT_MS=30000
# Worker settings — voice_asr_serve.py does not read .env; export these in its shell:
# VOICE_ASR_HOST=127.0.0.1
# VOICE_ASR_PORT=8768
# VOICE_ASR_BACKEND=funasr
# VOICE_ASR_MODEL=ASLP-lab/WSYue-ASR/sensevoice_small_yue
# VOICE_ASR_DEVICE=cpu
# VOICE_ASR_LANGUAGE=yue
# VOICE_ASR_FFMPEG=ffmpeg
# Qwen backend alternative: set VOICE_ASR_BACKEND=qwen; install requirements-voice-qwen.txt instead.
# VOICE_ASR_QWEN_DTYPE=float32
# Optional fallback context; the bot sends safer poll-specific context:
# VOICE_ASR_QWEN_CONTEXT=

# --- WhatsApp transport (whatsmeow | wwebjs) ---
# whatsmeow = pure-Go sidecar (wa-bridge/, no Chromium, Linux/macOS/Windows; default).
# wwebjs = legacy Chromium + whatsapp-web.js fallback.
# WA_TRANSPORT=whatsmeow
# Auto-starts wa-bridge by default when neither WA_BRIDGE_URL nor WA_BRIDGE_TOKEN is set.
# Set 0 when pointing WA_BRIDGE_URL + WA_BRIDGE_TOKEN at an external standalone sidecar.
# WA_BRIDGE_AUTO_START=1
# WA_BRIDGE_BIN=wa-bridge/wa-bridge
# WA_BRIDGE_URL=http://127.0.0.1:8767
# WA_BRIDGE_TOKEN=
# WA_BRIDGE_DB_PATH=./wa-bridge.db
# WA_BRIDGE_CURSOR_PATH=./wa-bridge-cursor.json
# WA_BRIDGE_TIMEOUT_MS=15000
# WA_BRIDGE_HOST=127.0.0.1
# WA_BRIDGE_PORT=8767
# WA_BRIDGE_LOG_LEVEL=WARN

# WhatsApp Web / Puppeteer (used when WA_TRANSPORT=wwebjs)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_DOWNLOAD=true
# Opt in only when needed: 1 disables Chromium sandboxing; unset by default.
# Running as root already disables the sandbox regardless of this setting.
# PUPPETEER_NO_SANDBOX=0

# --- Checkpoint download helper (scripts/download_jevlike_ckpt.sh) ---
# Export in the helper's shell; it does not read .env.
# JEVLIKE_RELEASE_REPO=KLHA829/scam-detection-jev
# JEVLIKE_RELEASE_TAG=jevlike-hf-r1
# JEVLIKE_RELEASE_ASSET=jevlike_hf_chinese_roberta_r1.pt
# URL defaults to https://github.com/{repo}/releases/download/{tag}/{asset}.
# JEVLIKE_DOWNLOAD_URL=
# Minimum accepted checkpoint size (bytes).
# JEVLIKE_CKPT_MIN_BYTES=1000000
# Set exactly 1 to force a re-download instead of keeping an existing checkpoint.
# JEVLIKE_CKPT_FORCE=0
# Optional GitHub auth; both unset by default. GH_TOKEN wins over GITHUB_TOKEN.
# GH_TOKEN=
# GITHUB_TOKEN=
