# Primary scorer: jevlike (HF encoder head) on a local worker.
# Default. Raspberry Pi / CPU machines should use this.
SCORER=jevlike

# --- jevlike worker (python jevlike_serve.py) ---
JEVLIKE_BASE_URL=http://127.0.0.1:8766
JEVLIKE_API_KEY=
JEVLIKE_TIMEOUT_MS=30000
JEVLIKE_HOST=127.0.0.1
JEVLIKE_PORT=8766
# Checkpoint already published (do not wait for another upload):
#   https://github.com/KLHA829/scam-detection-jev/releases/download/jevlike-hf-hn800/jevlike_hf_chinese_roberta_hn800.pt
# scripts/download_jevlike_ckpt.sh copies it to the conventional path below.
JEVLIKE_CKPT=models/jevlike_hf_chinese_roberta.pt
JEVLIKE_ENCODER=hfl/chinese-roberta-wwm-ext
JEVLIKE_DEVICE=cpu
JEVLIKE_OPTIONS=not_scam,scam

# Fallback: previous LightJev 0.6B multi-label rubric (not the Pi default).
# SCORER=model_v2
# LIGHTJEV_BASE_URL=http://127.0.0.1:8765
# LIGHTJEV_API_KEY=
# LIGHTJEV_TIMEOUT_MS=30000
# LIGHTJEV_HOST=127.0.0.1
# LIGHTJEV_PORT=8765
# LIGHTJEV_CHECKPOINT=rongxinzy/LightJev-0.6B-v0.1
# LIGHTJEV_DEVICE=cpu
# LIGHTJEV_TEMPERATURE=1

# LightJev typed-decision endpoint (only when SCORER=model_v2 / lightjev).
# Start the worker first: python lightjev_serve.py
LIGHTJEV_BASE_URL=http://127.0.0.1:8765
LIGHTJEV_API_KEY=
LIGHTJEV_TIMEOUT_MS=30000

# Worker-only (python lightjev_serve.py)
LIGHTJEV_HOST=127.0.0.1
LIGHTJEV_PORT=8765
LIGHTJEV_CHECKPOINT=rongxinzy/LightJev-0.6B-v0.1
LIGHTJEV_DEVICE=cpu
LIGHTJEV_TEMPERATURE=1

# Rubric thresholds (0–100). Override scoring-rubric.json without code changes.
# jevlike maps P(scam)*100 onto the same scale; LightJev (model_v2) still uses
# the 10-dimension weighted sum.
ARCHIVE_THRESHOLD=42
SAFE_THRESHOLD=18

# Optional: JSON file path (default: ./scoring-rubric.json)
# RUBRIC_PATH=./scoring-rubric.json

# Heuristic backup (archive-only). Set 0/false to disable.
HEURISTIC_ENABLED=true

# Startup: archive unsaved non-local numbers in the first 10 sidebar 1:1 chats (no scoring).
STARTUP_FOREIGN_SCAN=true

# Score cache TTL in ms (0 disables).
SCORE_CACHE_TTL_MS=900000

# --- Second-pass LLM review (grey / conflict / high score; fail-open on grey) ---
# Off by default. Heuristic / RAG / local-classifier / foreign-number archives skip the LLM.
# Score-only archives (jevlike_score / lightjev_score) get a second look when enabled:
#   - grey band: score/100 in [GREY_MIN, GREY_MAX] (defaults 0.40–0.85)
#   - high: score/100 > GREY_MAX (same 0–1 scale; primary score is 0–100)
# LLM not_scam can *release* a score-only archive (friend/family false positives).
# LLM unknown/timeout keeps a high/score archive (fail toward scam on high);
# grey-band messages that were not already archived still fail-open (do not archive).
# Lower GREY_MIN toward SAFE_THRESHOLD/100 (0.18) to send more unknowns to the LLM.
# Raise ARCHIVE_THRESHOLD if you want fewer primary archives before the LLM second look.
LLM_REVIEW_ENABLED=false
# Default true once LLM review is enabled. Set false to skip scores above GREY_MAX.
LLM_REVIEW_ON_HIGH=true
# After the primary scorer, also send EVERY remaining message to the LLM.
# Default 0 = grey/high/conflict path above. 1 = every DM (still skips hard
# archives: foreign_number / obvious_scam / rag / local classifier, and
# suppressed warning copy). Implies review is enabled. PII is still redacted.
LLM_REVIEW_ALL=0
# Merge when LLM disagrees with jevlike / model_v2:
#   bonsai (default, FP-aware): LLM scam → archive; LLM not_scam → release
#     score-only archives; unknown/fail → keep primary.
#   archive_only: LLM may add archives but never release a score archive.
LLM_REVIEW_MERGE=bonsai
# Backend is any OpenAI-compatible Chat Completions API (not a single vendor):
# POST {base}/chat/completions. Cloud OpenAI, Ollama, vLLM, llama.cpp llama-server, etc.
# LLM_REVIEW_API_URL=https://api.openai.com/v1
# LLM_REVIEW_API_URL=http://127.0.0.1:11434/v1
# llama.cpp llama-server example (Ternary-Bonsai or any GGUF):
# LLM_REVIEW_API_URL=http://127.0.0.1:8081/v1
# LLM_REVIEW_MODEL=Ternary-Bonsai-2-27B
# Aliases if LLM_REVIEW_API_URL is unset: OPENAI_BASE_URL, OPENAI_API_BASE
# API key is optional for local servers that do not require auth. When set, sent as
# Authorization: Bearer <key>. Aliases: OPENAI_API_KEY.
# LLM_REVIEW_API_KEY=          # empty / omit for llama-server with no --api-key
# LLM_REVIEW_API_KEY=local     # llama-server with a dummy or real key
# LLM_REVIEW_API_KEY=sk-...    # OpenAI cloud
# OPENAI_API_KEY=
LLM_REVIEW_API_KEY=
LLM_REVIEW_MODEL=gpt-4o-mini
LLM_REVIEW_TIMEOUT_MS=8000
LLM_REVIEW_GREY_MIN=0.40
LLM_REVIEW_GREY_MAX=0.85
# Short OTP-ish DMs (length <= this) can trigger review even below the grey band.
LLM_REVIEW_OTP_MAX_CHARS=96

# WhatsApp Web / Puppeteer
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_DOWNLOAD=true
