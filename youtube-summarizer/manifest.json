{
  "manifest_version": 3,
  "name": "YouTube summary (OpenCode Go)",
  "version": "1.0.0",
  "description": "Summarize the YouTube video you are watching with your OpenCode Go API key.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*", "https://opencode.ai/*"],
  "action": {
    "default_title": "Summarize this YouTube video",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "48": "icon.png" }
}
